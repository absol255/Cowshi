# Copy to .env.local for local work; on Vercel set these under Project Settings -> Environment Variables.

# Signs the bettor and admin session cookies. Use a long random string:  openssl rand -hex 32
SECRET_KEY=

# Postgres connection string (Vercel Postgres / Neon sets DATABASE_URL or POSTGRES_URL for you).
# Leave empty locally to store data in web/data/store.json instead.
DATABASE_URL=

# Password for the seeded "admin" account. Read once, when the database is first created.
ADMIN_PASSWORD=
