# Copy to .env.local for local work; on Vercel set these under Project Settings -> Environment Variables.

# Postgres connection string. POSTGRES_URL is also accepted, and so are the variables
# the Vercel Postgres / Neon integration sets. Leave empty locally to use web/data/store.json.
DATABASE_URL=

# Signs the bettor and admin session cookies. Use a long random string:  openssl rand -hex 32
SECRET_KEY=

# Optional extra admin login: this password works for the ADMIN_USERNAME account (default "admin").
# The row in the admins table is created or refreshed to match. Other admins are unaffected.
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Set to false before the first request to start a new database with no demo markets.
# SEED_DEMO_MARKETS=false

# Only if your database's TLS certificate can't be verified:
# DATABASE_SSL=no-verify
