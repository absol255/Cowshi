# Copy to .env.local for local work; on Vercel set these under Project Settings -> Environment Variables.

# Postgres connection string. POSTGRES_URL is also accepted, and so are the variables the
# Vercel Postgres / Neon integration sets. Leave empty locally to use data/store.json.
DATABASE_URL=

# Signs the bettor and admin session cookies. Use a long random string:  openssl rand -hex 32
SECRET_KEY=

# Password for the admin account (ADMIN_USERNAME, default "admin"). That account is created or
# refreshed to match. Needed on Vercel if your admins table is empty.
ADMIN_PASSWORD=
# ADMIN_USERNAME=admin

# Set to false before the first visit to start a new database with no demo markets.
# SEED_DEMO_MARKETS=false

# Only say "wrong username or password" on sign-in failures.
# GENERIC_LOGIN_ERRORS=true

# Only if your database's TLS certificate can't be verified:
# DATABASE_SSL=no-verify
